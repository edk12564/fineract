package org.apache.fineract.accounting.journalentry.api;

import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.responses.ApiResponse;
import jakarta.ws.rs.Consumes;
import jakarta.ws.rs.GET;
import jakarta.ws.rs.Path;
import jakarta.ws.rs.Produces;
import jakarta.ws.rs.core.MediaType;
import org.springframework.stereotype.Component;

/**
 * DUMMY ENDPOINT - DO NOT MERGE INTO MAIN
 *
 * This endpoint exists solely to demonstrate that OpenAPI operationId deduplication
 * numbers are unstable. By adding this single endpoint with a generic retrieveAll()
 * method, the Swagger plugin will shift the deduplication suffixes for all other
 * retrieveAll endpoints in the generated fineract.yaml spec.
 *
 * To prove the issue:
 * 1. Run: ./gradlew :fineract-provider:resolve (WITHOUT this file) and note operationIds
 * 2. Add this file back
 * 3. Run: ./gradlew :fineract-provider:resolve (WITH this file) and compare operationIds
 * 4. Observe that the journal entries operationId (retrieveAll_1) shifts to a different number
 *
 * See also: prove-operationid-shift.sh in the project root
 */
@Path("/v1/dummytest")
@Component
public class DummyRetrieveAllTestEndpoint {

    @GET
    @Consumes({ MediaType.APPLICATION_JSON })
    @Produces({ MediaType.APPLICATION_JSON })
    @Operation(summary = "Dummy test endpoint to prove operationId instability")
    @ApiResponse(responseCode = "200", description = "OK")
    public String retrieveAll() {
        return "[]";
    }
}
